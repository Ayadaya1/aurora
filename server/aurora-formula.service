[Unit]
Description=Formula OCR API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/aurora-server/server
ExecStart=/root/aurora-server/server/.venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
Environment=FORMULA_CPU_THREADS=2
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
